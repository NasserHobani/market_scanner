# انسخه إلى .env واملأه
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# المسح التلقائي: يعمل مع الخادم بلا أوامر يدوية
#
# ═══ انتبه: هذا السطر يحكم شيئين لا شيئاً واحداً ═══
#
# الأسواق المذكورة هنا هي التي تُمسَح **وتُزامَن شموعها** (إذ
# ‏MARKET_SYNC_MARKETS تقع عليه افتراضاً). فالسوق غير المذكور لا
# يُمسَح ولا تُحدَّث شموعه — واللوحة تعرض آخر دورة له مهما قدُمت.
#
# وهذا يبدو سليماً تماماً: أرقام تظهر، ولا خطأ، ولا صفر نتائج.
# ظلّ السوق الأمريكي على دورةٍ عمرها أسابيع لأنّ الافتراض هنا
# ``crypto`` وحده.
AUTO_SCAN=1
AUTO_SCAN_MARKETS=crypto,us,saudi

# مراقبة الفرص: تنبيه تيليجرام عند بلوغ سعر الدخول
WATCH_MONITOR=1
WATCH_INTERVAL_SECONDS=300
# لأكثر من سوق:  AUTO_SCAN_MARKETS=crypto,us,saudi

# احذف هذه الأسطر لاستخدام SQLite بدل PostgreSQL
POSTGRES_DB=scanner
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# التوكن كاملاً: رقم + نقطتان + نص  →  8123456789:AAGcgVxI-oPqRs…
TELEGRAM_TOKEN=AAFSegYCCLniU0Ni9r1ZHcVQ7iWn09QXRQ0
TELEGRAM_CHAT_ID=8952232652

# سهمك — السوق السعودي · https://www.sahmk.sa/developers/register
# الشركات مجانية؛ الشموع التاريخية تحتاج Starter فأعلى،
# و1h/4h تحتاجان Pro فأعلى.
SAHMK_API_KEY=
