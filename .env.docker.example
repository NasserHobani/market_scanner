# ═══════════════════════════════════════════════════════════════
#  متغيّرات النشر — وهي نفسها في الحالتين
# ═══════════════════════════════════════════════════════════════
#
# **محلّياً:** انسخ هذا الملفّ إلى ‎.env‎ واملأه. و‏compose يقرؤه
#   تلقائياً — لا تحتاج ``env_file`` ولا ``--env-file``.
#
#       cp .env.docker.example .env
#
# **ببورتينر:** لا تنسخ شيئاً. الصق هذه الأسطر في خانة
#   ‎Environment variables‎ داخل الـStack (زرّ ‎Advanced mode‎
#   يقبل اللصق دفعةً واحدة).
#
# و‎.env‎ نفسه **لا يُرفع إلى GitHub** — يمنعه ‎.gitignore‎، ويمنعه
# ‎.dockerignore‎ من دخول الصورة. وهذا القالب بلا قيم.


# ══════════ مطلوبة — بلاها لا يُقلع المكدّس ══════════

# ولّده مرّة واحدة واحفظه:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
#
# وتركُه فارغاً يوقف الإقلاع عمداً: ‏settings.py يولّد مفتاحاً
# ويكتبه في ‎.env‎ إن لم يجده — وفي الحاوية لا يُحفظ شيء، فيتولّد
# مفتاحٌ جديد عند كل إقلاع وتنتهي كل الجلسات بلا سبب ظاهر.
DJANGO_SECRET_KEY=

# كلمة مرور القاعدة. تُنشأ مرّة عند أوّل إقلاع، وتغييرها بعده
# **لا** يغيّر القاعدة القائمة — يمنع الاتّصال بها فقط.
POSTGRES_PASSWORD=

# ═══ اذكر اسم نطاقك أو عنوان الخادم هنا ═══
#
# ‏Django يقارن ترويسة ‎Host‎ بهذه القائمة ويردّ «Bad Request (400)»
# على ما لا يطابق — بلا شرح. فمن نسي عنوانه هنا يرى صفحة خطأ
# فارغة ويظنّ الخادم معطوباً.
#
# مثال:  localhost,127.0.0.1,scanner.example.com,203.0.113.10
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1


# ══════════ الوصول — اقرأ التحذير ══════════

# ⚠ لا تسجيل دخول في هذا النظام. ولا صفحة واحدة تسأل عن هويّة.
#
# ‎127.0.0.1‎ يعني: الخدمة تعمل ولا تُرى من خارج الخادم — وهو
# الافتراض الآمن. والوصول عبر نفق SSH:
#
#     ssh -L 8000:127.0.0.1:8000 user@server
#
# و‎0.0.0.0‎ يفتحها للإنترنت كلّه بلا أيّ حاجز. لا تكتبها حتى
# تضع وكيلاً عكسياً بكلمة مرور أمامها. انظر docs/PORTAINER.md.
WEB_BIND=127.0.0.1
WEB_PORT=8000


# ══════════ اختيارية — لها قيمٌ افتراضية ══════════

POSTGRES_DB=scanner
POSTGRES_USER=scanner
SCANNER_TIMEZONE=Asia/Riyadh

# كل كم ثانية يسأل المجدول القاعدة عن المستحقّ. وفتراتُ كل
# مهمّة تُضبط من شاشة ‎/jobs/‎ لا من هنا.
SCHEDULER_INTERVAL_SECONDS=60

# ‏1 عند أوّل إقلاع على قاعدةٍ جديدة، ثمّ يمكن جعله 0.
# وهو آمن مع التكرار: لا يُنشئ ما هو موجود.
SEED_JOBS=1

# ═══ هذا السطر يحكم شيئين ═══
#
# السوق المذكور هنا يُمسَح **وتُزامَن شموعه**. وغير المذكور لا
# يُمسَح ولا تُحدَّث شموعه — واللوحة تعرض آخر دورة له مهما قدُمت،
# بلا خطأ ولا صفر نتائج.
AUTO_SCAN_MARKETS=crypto,us,saudi


# ══════════ مفاتيح الأسواق والتنبيهات ══════════
#
# ⚠ المفاتيح التي ظهرت في لقطة شاشة سابقة يجب أن تكون قد أُبطلت
#   وأُعيد توليدها. ولا تُنسخ هنا مفاتيح قديمة.
#
# وليس لازماً ملؤها كلّها: السوق بلا مفتاح يُترك خارج
# ‎AUTO_SCAN_MARKETS‎.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
SAHMK_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# يُترك فارغاً فيرتدّ المحلّل إلى المزوّد المحلّي
ANTHROPIC_API_KEY=


# ══════════ مثبَّتة في compose — لا تُضبط هنا ══════════
#
#   POSTGRES_HOST=db      اسم الخدمة في شبكة المكدّس
#   POSTGRES_PORT=5432
#   DJANGO_DEBUG=0        إظهار الأثر على خادمٍ مكشوف تسريبُ إعدادات
#   SCHEDULER_ENGINE=off  في الويب — وإلّا عمل محرّكٌ في كل عامل
